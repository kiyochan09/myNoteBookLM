# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*.class
*.bak

# Environments & IDEs
.env
.venv
env/
venv/
runtimes/ocr/venv/
runtimes/ocr/src/model/*.onnx
ENV/
