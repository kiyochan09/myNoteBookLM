.idea/

# Scratch & temporary test files
scratch/
*.tmp
*.log
data/test_out/
data/temp_uploads/
data/ocr_results/
data/pdf_cache/
data/.app_token
data/*_bak/
data/ocr_results/*_bak/

# Large SQLite databases (my_notebook.db is > 1.2GB)
*.db
*.sqlite
*.sqlite3

# Large document binaries and generated media cache (> 2GB)
data/media/
data/*.pdf
data/*.docx
data/*.xlsx
data/*.pptx
data/*.odt

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Local research embeddings and isolated runtime
.venv_research/
models/research/
data/research_index.lock

# Per-user encrypted AI credentials
data/research_ai.json
data/research_ai.tmp

# User data stays local, including PDFs, dictionaries and document media.
/[Dd][Aa][Tt][Aa]/

# Backup contents and pending/restored datasets, not the backup feature's code.
.backup_restore/
.restore_history/
